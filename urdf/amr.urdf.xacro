<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr" >
  <xacro:include filename="$(find final_project)/urdf/amr_base_macro.urdf.xacro"/>
  <xacro:include filename="$(find final_project)/urdf/lidar_gazebo_macro.xacro"/>
  <xacro:property name="LIDAR" value="True"/>
  
  <xacro:amr_base/>
  
  <xacro:if value="${LIDAR}">
    <xacro:lidar_gazebo_sensor parent="lidar_link"/>
  </xacro:if>

</robot>
