<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="Blue">
      <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="Black">
      <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="Gray">
      <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <xacro:macro name="amr_base" >
    
    
   
   
    <link name="base_footprint"/>

    <link name="base_link" >
      <inertial>
        
        <mass value="6.0" />
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
      </inertial>
      <visual> 
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="model://final_project/meshes/AMR_base.stl" scale ="0.5 0.5 0.5"/></geometry>
        <material name= "Blue"/>
      </visual>
      <visual>
        <origin xyz="0.3 0.0 -0.01" rpy="0 0 0"/> 
        <geometry>
          <mesh filename="model://final_project/meshes/wheel_small.stl" scale ="0.001 0.001 0.001"/>
        </geometry>
        <material name="Gray"/>
      </visual>
      <visual>
        <origin xyz="-0.3 0.0 -0.01" rpy="0 0 0"/> 
        <geometry>
          <mesh filename="model://final_project/meshes/wheel_small.stl" scale ="0.001 0.001 0.001"/>
        </geometry>
        <material name="Gray"/>
      </visual>
     
      <collision>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <geometry><box size="0.8 0.6 0.148"/></geometry>
      </collision>
      <collision>
        <geometry>
          <sphere radius="0.03" />
        </geometry>
        <origin xyz="0.3 0.0 -0.01" rpy="0 0 0" /> 
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>   
              <mu2>0.001</mu2> 
            </ode>
          </friction>
        </surface>
      </collision>
      
      <collision>
        <geometry>
           <cylinder radius="0.03" length="0.01"/> <!--<sphere radius="0.035" />-->
        </geometry>
        <origin xyz="-0.3 0.0 -0.01" rpy="1.5708 0 0" /> 
         <surface>
          <friction>
            <ode>
              <mu>0.001</mu>   
              <mu2>0.001</mu2> 
            </ode>
          </friction>
        </surface>
      </collision>   
    </link>

    <xacro:macro name="wheel_link" params="name">
      <link name="${name}_wheel_link">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="model://final_project/meshes/wheel_small.stl" scale ="0.001 0.001 0.001"/></geometry>
          <material name= "Gray"/>
        </visual>
        <collision>
          <origin xyz="0 0.002 0" rpy="1.57 0 0"/>
          <geometry><cylinder radius="0.035" length="0.005"/></geometry>
          <surface>
            <friction>
             <ode>
              <mu>100.0</mu>   
              <mu2>100.0</mu2> 
             </ode>
           </friction>
          </surface>
        </collision>
        <inertial>
          <mass value="2.5" />
          <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
      </link>
    </xacro:macro>

    <xacro:wheel_link name="left"/>
    <xacro:wheel_link name="right"/>

    <!--<xacro:wheel_link name="left_caster"/>
    <xacro:wheel_link name="right_caster"/>-->

    <link name="container_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 1.5708"/>
        <geometry><mesh filename="model://final_project/meshes/platform.dae" scale ="0.65 0.5 1"/></geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin xyz="0 0.4 0.25" rpy="0 0 0"/> 
        <geometry><box size="0.55 0.01  0.4"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.28 0 0.15" rpy="0 0 0"/> 
        <geometry><box size="0.01 0.8  0.25"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.4 0.25" rpy="0 0 0"/> 
        <geometry><box size="0.55 0.01  0.4"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.28 0 0.15" rpy="0 0 0"/> 
        <geometry><box size="0.01 0.8  0.25"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/> 
        <geometry><box size="0.55 0.8  0.02"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5" />
        <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08" />
      </inertial>
    </link>

    <link name="lidar_link" />
    <link name="lidar_amr_house">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.2 0.6"/></geometry>
        <material name="Black"/>
      </visual>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="0.08 0.2 0.6"/></geometry>
      </collision>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint" />
      <child link="base_link" />
      <origin xyz="0.0 0.0 0.059" rpy="0 0 0" />
    </joint>

    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="left_wheel_link" />
      <origin xyz="0.0 0.15  -0.01" rpy="0 0 0" /> 
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="100" />
      <dynamics damping="0.5" friction="0.01" />
    </joint>

    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="right_wheel_link" />
      <origin xyz="0.0 -0.15 -0.01" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="100" />
      <dynamics damping="0.5" friction="0.01" />
    </joint>

   

    <joint name="container_joint" type="fixed">
      <parent link="base_link"/>
      <child link="container_link"/>
      <origin xyz="0.0 0.0 0.20" rpy="0 0 0" />
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_link" />
      <origin xyz="0.25 0.0 0.8" rpy="0 0 0" />
    </joint>
    <joint name="lidar_house_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_amr_house" />
      <origin xyz="0.35 0.0 0.5" rpy="0 0 0" />
    </joint>

   

    <gazebo>
      <plugin name="ignition::gazebo::systems::DiffDrive" filename="libignition-gazebo-diff-drive-system.so">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.3</wheel_separation>
        <wheel_radius>0.035</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
