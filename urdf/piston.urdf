<?xml version="1.0"?>
<robot name="piston_pneumatic">

  <link name="world"/>

  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.6 2.0 "/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.6 2.0 "/>
      </geometry>
    </collision>
  </link>

  <joint name="fixed_to_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="pusher_rod">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 1.57 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.4"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.4"/>
      </geometry>
    </collision>
  </link>

  <joint name="pusher_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="pusher_rod"/>
    <origin xyz="0.2 0 0.9" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.0" effort="1000" velocity="2.0"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <ros2_control name="IgnitionSystem" type="system">
   <hardware>
    <plugin>ign_ros2_control/IgnitionSystem</plugin>
   </hardware>
   <joint name="pusher_joint">
    <command_interface name="effort">
      <param name="min">-1000</param>
      <param name="max">1000</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
   </joint>
  </ros2_control>

  <gazebo>
   <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
    <parameters>/home/user/ros2_ws/src/final_project/config/controllers.yaml</parameters>
    <ros>
      <namespace>piston_ns</namespace>
    </ros>
    <robot_param_node>rsp_piston</robot_param_node>
   </plugin>
  </gazebo>

</robot>
