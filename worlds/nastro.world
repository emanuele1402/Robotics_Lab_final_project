<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="conveyor_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-particle-emitter2-system"
      name="ignition::gazebo::systems::ParticleEmitter2">
    </plugin>
  


    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="conveyor_belt">
      <static>true</static>
      <pose>0.0 0.0 1.0 0 0 0</pose> 
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.5 0.1</size></box></geometry>
        </collision>
        <collision name="collision_leg1">
          <pose>2.4 0 -0.45 0 0 0</pose> 
          <geometry><box><size>0.1 0.5 1.0</size></box></geometry>
        </collision>
        <collision name="collision_leg2">
          <pose>-2.4 0 -0.45 0 0 0</pose> 
          <geometry><box><size>0.1 0.5 1.0</size></box></geometry>
        </collision>

        <visual name="frame_left">
          <pose>0 0.26 0 0 0 0</pose>
          <geometry><box><size>5.0 0.02 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="frame_right">
          <pose>0 -0.26 0 0 0 0</pose>
          <geometry><box><size>5.0 0.02 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <visual name="belt_visual">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>5.0 0.48 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

        <visual name="leg1"><pose>2.4 0 -0.45 0 0 0</pose><geometry><box><size>0.1 0.5 1.0</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="leg2"><pose>-2.4 0 -0.45 0 0 0</pose><geometry><box><size>0.1 0.5 1.0</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>

        <visual name="sensor_housing">
          <pose>1.5 0.28 0.1 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.1</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>

        <sensor name="lidar_sensor" type="gpu_lidar">
          <pose>1.5 0 0.2 0 0 0</pose>
          <topic>lidar_scan</topic>
          <lidar>
            <scan>
             <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
             </horizontal>
            </scan>
            <range>
             <min>0.05</min>
             <max>0.6</max>
            </range>
          </lidar>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <model name="box1">
      <pose>-0.5 0.0 1.16 0 0 0</pose> 
      <link name="box_link">
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <velocity_decay>
          <linear>10.0</linear>
          <angular>10.0</angular>
        </velocity_decay>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </collision> 
        <visual name="visual">
	  <geometry>
	    <mesh>
	      <uri>model://final_project/meshes/box1.dae</uri>
	    </mesh>
	  </geometry>
	  <surface>
	    <friction>
	      <ode>
		<mu>100.0</mu>     <mu2>100.0</mu2>    </ode>
	    </friction>
	    <contact>
	      <ode>
		<kp>1000000.0</kp>  <kd>1.0</kd>        </ode>
	    </contact>
	 </surface>
	</visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl"><link_name>box_link</link_name></plugin>
    </model>
    
    <model name="box1_painted">
      <pose>-50 0 -50 0 0 0</pose> 
