	    </contact>
	 </surface>
        </collision> 
        <visual name="visual">
	  <geometry>
	    <mesh>
	      <uri>model://final_project/meshes/box1_painted.dae</uri>
	    </mesh>
	  </geometry>
	</visual>
      </link>
      
    </model>

